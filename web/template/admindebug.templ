package template

templ AdminDebug(deployment, versionName, versionRef string, onECS, pprofEnabled bool) {
<!DOCTYPE html>
<html lang="en">
@Head("Debugging Details", "admin_debug.js", false, versionRef)

<body>
<div class="container-fluid">
@Header(deployment)
@Nav("")
<main id="main" tabindex="-1">
<h1 id="doc-title">Server Debugging Details</h1>

@ErrorInfo()

@HelpModal("Debug", "admin") {
  @helpOnlyGoToShortcut()
}

<h2 class="h4">Server Info</h2>
<p><button id="show-build-info" class="btn btn-sm btn-default btn-primary">Fetch Server Info</button></p>
<div id="build-info-div" style="display:none;">
  <p id="build-info-p"></p>
  <pre id="build-info"></pre>
</div>

<h2 class="h4">Server Configuration</h2>
<p><button id="show-config" class="btn btn-sm btn-default btn-primary">Fetch Server Configuration</button></p>
<div id="config-div" style="display:none;">
  <p id="config-p">Secrets are redacted.</p>
  <pre id="config"></pre>
</div>

<h2 class="h4">Databases</h2>
<p>
  <button id="show-db-info" class="btn btn-sm btn-default btn-primary">Fetch Database Info</button>
  <button id="show-db-variables" class="btn btn-sm btn-default btn-primary">Fetch All Database Variables</button>
</p>
<div id="db-info-div" style="display:none;">
  <pre id="db-info"></pre>
</div>
<div id="db-variables-div" style="display:none;">
  <pre id="db-variables"></pre>
</div>

<h2 class="h4">ECS Task Metadata</h2>
if !onECS {
<p class="text-body-secondary">Unavailable: the server isn't running on AWS ECS.</p>
}
<p><button id="show-ecs-metadata" class="btn btn-sm btn-default btn-primary" disabled?={ !onECS }>Fetch ECS Task Metadata</button></p>
<div id="ecs-metadata-div" style="display:none;">
  <p id="ecs-metadata-p"><a href="https://docs.aws.amazon.com/AmazonECS/latest/developerguide/task-metadata-endpoint-v4-fargate.html">See the endpoint documentation here</a></p>
  <pre id="ecs-metadata"></pre>
</div>

<h2 class="h4">Profiling</h2>
if !pprofEnabled {
<p class="text-body-secondary">Unavailable: profiling is turned off by <code>IMS_DISABLE_PPROF</code>.</p>
}
<p>
  Download a pprof profile of the server, then open it with
  <code>go tool pprof -http=: FILE</code>, or a trace with <code>go tool trace FILE</code>.
  The CPU profile takes 30 seconds to collect, and the trace 5 seconds.
</p>
<p>
  @pprofLink(pprofEnabled, "/ims/api/debug/pprof/profile?seconds=30", "cpu.pb.gz", "CPU (30s)")
  @pprofLink(pprofEnabled, "/ims/api/debug/pprof/heap", "heap.pb.gz", "Heap")
  @pprofLink(pprofEnabled, "/ims/api/debug/pprof/allocs", "allocs.pb.gz", "Allocs")
  @pprofLink(pprofEnabled, "/ims/api/debug/pprof/goroutine", "goroutine.pb.gz", "Goroutines")
  @pprofLink(pprofEnabled, "/ims/api/debug/pprof/threadcreate", "threadcreate.pb.gz", "Thread Creation")
  @pprofLink(pprofEnabled, "/ims/api/debug/pprof/trace?seconds=5", "trace.out", "Trace (5s)")
  @pprofLink(pprofEnabled, "/ims/api/debug/pprof/goroutine?debug=2", "", "Goroutine Stacks (text)")
</p>

<h2 class="h4">Garbage Collection</h2>
<p><button id="perform-gc" class="btn btn-sm btn-default btn-primary">Perform GC</button></p>
<div id="gc-div" style="display:none;">
  <pre id="gc"></pre>
</div>

<h2 class="h4">Runtime Metrics</h2>
<p><button id="show-metrics" class="btn btn-sm btn-default btn-primary">Fetch Runtime Metrics</button></p>
<div id="runtime-metrics-div" style="display:none;">
  <p id="runtime-metrics-p"><a href="https://pkg.go.dev/runtime/metrics#hdr-Supported_metrics">See the metric definitions here</a></p>
  <pre id="runtime-metrics"></pre>
</div>

</main>
@Footer(versionName, versionRef)
</div>
</body>
</html>
}

// pprofLink downloads the profile at href as the file named download, or opens it
// in a new tab when download is empty. When disabled it renders without an href,
// since an <a> has no disabled attribute.
templ pprofLink(enabled bool, href, download, label string) {
	if !enabled {
		<a class="btn btn-sm btn-default btn-primary disabled" role="link" aria-disabled="true">{ label }</a>
	} else if download == "" {
		<a class="btn btn-sm btn-default btn-primary" href={ templ.SafeURL(href) } target="_blank">{ label }</a>
	} else {
		<a class="btn btn-sm btn-default btn-primary" href={ templ.SafeURL(href) } download={ download }>{ label }</a>
	}
}
