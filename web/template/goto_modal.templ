package template

templ GoToModal() {
<dialog class="ims-modal goto-modal no-print" id="goToModal" aria-label="Go to...">
  <div class="modal-content">
    <div class="goto-header">
      <span>Go to</span>
      <select id="goto-event" class="form-select goto-event" aria-label="Event"></select>
      <button type="button" class="btn-close ms-auto" data-ims-close aria-label="Close" tabindex="-1" />
    </div>
    <div id="goto-kind-group" class="goto-kinds" role="group" aria-label="Record type">
      <input type="radio" class="btn-check" name="goto-kind" id="goto-kind-incident"
             value="incident" autocomplete="off" checked />
      <label for="goto-kind-incident">Incident</label>
      <input type="radio" class="btn-check" name="goto-kind" id="goto-kind-field-report"
             value="field_report" autocomplete="off" />
      <label for="goto-kind-field-report">Field report</label>
      <input type="radio" class="btn-check" name="goto-kind" id="goto-kind-visit"
             value="visit" autocomplete="off" />
      <label for="goto-kind-visit">Visit</label>
    </div>
    <label class="goto-number">
      <span class="goto-hash" aria-hidden="true">#</span>
      <input id="goto-number" type="text" inputmode="numeric" enterkeyhint="go" autocomplete="off"
             aria-label="Number" aria-describedby="goto-preview" />
    </label>
    <div id="goto-preview" class="goto-preview text-truncate" aria-live="polite"></div>
    <p class="goto-hints">
      <span><kbd>↵</kbd> open</span>
      <span><kbd><span class="modifier-key">Ctrl</span> ↵</kbd> new tab</span>
    </p>
  </div>
</dialog>
}
