package template

// HelpModal is the dialog that "?" opens on every page. helpAnchor names the
// section of the Help page to link to, or is empty for no link.
templ HelpModal(pageName, helpAnchor string) {
<dialog class="ims-modal no-print" id="helpModal" aria-labelledby="helpModalLabel">
  <div class="modal-content">
    <div class="modal-header">
      <p class="modal-title fs-5" id="helpModalLabel">{ pageName } help</p>
      <button type="button" class="btn-close" data-ims-close aria-label="Close" />
    </div>
    <div class="modal-body">
      { children... }
      if helpAnchor != "" {
        <p class="mt-3 mb-0">
          <a href={ templ.URL("/ims/app/help#" + helpAnchor) } target="_blank">
            More in IMS Help<span class="visually-hidden">{ " " }(opens in a new tab)</span>
          </a>
        </p>
      }
    </div>
  </div>
</dialog>
}

templ helpNoShortcuts() {
<p class="mb-0">This page has no keyboard shortcuts.</p>
}

templ helpShortcutsOffNote() {
<p class="mt-3 mb-0 text-body-secondary">These single-key shortcuts can be turned off on the <a href="/ims/app/settings">Settings page</a>.</p>
}

templ helpGoToShortcut() {
<li><kbd><kbd class="modifier-key">Ctrl</kbd> + <kbd>k</kbd></kbd>: go to a record by number, even while typing</li>
}
