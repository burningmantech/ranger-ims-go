package template

import "strings"

templ Incidents(deployment, versionName, versionRef, eventName string) {
<!DOCTYPE html>
<html lang="en">
@Head("Incidents | " + eventName, "incidents.js", true, versionRef)

<body>
<div class="container-fluid">
@Header(deployment)
@Nav(eventName)
<main id="main" tabindex="-1">

<div class="d-flex justify-content-between">
  <h1 id="doc-title">Incidents</h1>
  if strings.ToLower(deployment) == "production" {
  <span class="align-content-center" title="Are you an RSL/Operator/WSL? Please monitor #ranger-operations-center while on shift!">
    <a href="https://burningman.slack.com/archives/C07H1059327" target="_blank">
    <svg fill="currentColor" class="bi" aria-hidden="true" focusable="false">
      <use href="#slack" />
    </svg>
    ROC Chat<span class="visually-hidden"> on Slack (opens in a new tab)</span>
    </a>
  </span>
  }
</div>

@ErrorInfo()

    @HelpModal("Incidents", "incidents") {
      <p class="mb-0">Keyboard shortcuts</p>
      <ul>
        @helpGoToShortcut()
        <li><kbd>n</kbd>: create (n)ew Incident</li>
        <li><kbd>/</kbd>: jump to search field</li>
      </ul>
      <p class="mt-2 mb-0">In the search field</p>
      <ul>
        <li>Type an IMS number then press <kbd>Enter</kbd> to be redirected to that Incident</li>
        <li>Search by regular expression by enclosing a pattern with slashes, e.g. <code>/r.nger/</code> or <code>/\b(dog|cat)\b/</code></li>
        <li>All searches are case-insensitive</li>
      </ul>
      @helpShortcutsOffNote()
    }

    <p class="d-sm-none no-print">
      <a href="./field_reports/">
        → Field Reports
      </a>
    </p>

    <div class="row">
      <div class="col-sm-7">
        <div class="btn-group new_incident no-print">
          <a href="./incidents/new" id="new_incident" class="btn btn-sm btn-default btn-primary">
            New
          </a>
        </div>
        { }
        <button
                id="show_state"
                type="button"
                class="btn btn-light btn-sm dropdown-toggle"
                popovertarget="show_state_menu"
        >

          <span class="selection">Open</span>
        </button>
        <ul id="show_state_menu" class="dropdown-menu" popover>
          <li id="show_state_all" title="New, dispatched, on-scene, on-hold, or closed">
            <button type="button" class="name dropdown-item" data-value="all">All States</button>
          </li>
          <li id="show_state_open" title="New, dispatched, on-scene, or on-hold">
            <button type="button" class="name dropdown-item" data-value="open">Open</button>
          </li>
          <li id="show_state_active" title="New, dispatched, or on-scene">
            <button type="button" class="name dropdown-item" data-value="active">Active</button>
          </li>
          <li id="show_state_on_hold" title="On hold only">
            <button type="button" class="name dropdown-item" data-value="on_hold">On Hold</button>
          </li>
          <li class="border-top">
            <a href="/ims/app/settings" class="name dropdown-item">Change default</a>
          </li>
        </ul>
        { }
        <button
                id="show_days"
                type="button"
                title="Filter by last modified date"
                class="btn btn-light btn-sm dropdown-toggle"
                popovertarget="show_days_menu"
        >

          <span class="selection">All Days</span>
        </button>
        <ul id="show_days_menu" class="dropdown-menu" popover>
          <li id="show_days_all">
            <button type="button" class="name dropdown-item" data-value="all">All Days</button>
          </li>
          <li id="show_days_0">
            <button type="button" class="name dropdown-item" data-value="0">Today</button>
          </li>
          <li id="show_days_1">
            <button type="button" class="name dropdown-item" data-value="1">Last 2 Days</button>
          </li>
          <li id="show_days_2">
            <button type="button" class="name dropdown-item" data-value="2">Last 3 Days</button>
          </li>
          <li id="show_days_3">
            <button type="button" class="name dropdown-item" data-value="3">Last 4 Days</button>
          </li>
        </ul>
        { }
        <button
                id="show_type"
                type="button"
                class="btn btn-light btn-sm dropdown-toggle"
                popovertarget="ul_show_type"
        >
          Types
        </button>
        <ul id="ul_show_type" class="dropdown-menu" popover data-menu-stay-open>
          <li data-menu-filter-keep><button type="button" id="show_type_toggle_all" class="dropdown-item">Select/Deselect All</button></li>
          <li><button type="button" id="show_blank_type" class="dropdown-item dropdown-item-checkable dropdown-item-checked" aria-pressed="true">(blank)</button></li>
          <li><button type="button" id="show_other_type" class="dropdown-item dropdown-item-checkable dropdown-item-checked" aria-pressed="true" title="Show 'hidden' Incident Types">(other)</button></li>
          <template id="show_type_template">
            <li><button type="button" class="dropdown-item dropdown-item-checkable dropdown-item-checked"
                   aria-pressed="true" data-incident-type-id=""></button>
            </li>
          </template>
        </ul>
        { }
        <button
                id="show_rows"
                type="button"
                class="btn btn-light btn-sm dropdown-toggle"
                popovertarget="show_rows_menu"
        >

          <span class="selection">All Rows</span>
        </button>
        <ul id="show_rows_menu" class="dropdown-menu" popover>
          <li id="show_rows_all">
            <button type="button" class="name dropdown-item" data-value="all">All Rows</button>
          </li>
          <li id="show_rows_25">
            <button type="button" class="name dropdown-item" data-value="25">25 Rows</button>
          </li>
          <li id="show_rows_50">
            <button type="button" class="name dropdown-item" data-value="50">50 Rows</button>
          </li>
          <li id="show_rows_100">
            <button type="button" class="name dropdown-item" data-value="100">100 Rows</button>
          </li>
          <li class="border-top">
            <a href="/ims/app/settings" class="name dropdown-item">Change default</a>
          </li>
        </ul>
      </div>

      <div class="col-sm">
        <div id="search_container" class="form-group ms-auto">
          <div class="flex-input-container no-print">
            <a id="search-icon" href="/ims/app/search" class="btn btn-link p-0 me-1 align-content-center link-body-emphasis"
                title="Search all Events" aria-label="Search all Events">
              <svg fill="currentColor" class="bi" aria-hidden="true" focusable="false">
                <use href="#search" />
              </svg>
            </a>
            <label for="search_input" class="control-label visually-hidden">
              Search
            </label>
            <input
                    id="search_input"
                    type="search"
                    maxlength="256"
                    class="form-control search-box"
                    placeholder="Press &quot; ⁄ &quot; to search"
                    inputmode="latin"
                    { NoAutofill()... }
                    aria-controls="queue_table"
            />
          </div>
        </div>
      </div>

    </div>

    <table id="queue_table" class="table table-striped table-hover">
      <caption class="visually-hidden">Incidents</caption>
      <thead>
      <tr>
        <th scope="col"><abbr title="IMS#">#</abbr></th>
        <th scope="col">Started</th>
        <th scope="col">State</th>
        <th scope="col">Summary</th>
        <th scope="col">Types</th>
        <th scope="col">Location</th>
        <th scope="col">Rangers</th>
        <th scope="col">Modified</th>
      </tr>
      </thead>
      <tbody/>
      <tfoot>
      <tr>
        <th scope="col"><abbr title="IMS#">#</abbr></th>
        <th scope="col">Started</th>
        <th scope="col">State</th>
        <th scope="col">Summary</th>
        <th scope="col">Types</th>
        <th scope="col">Location</th>
        <th scope="col">Rangers</th>
        <th scope="col">Modified</th>
      </tr>
      </tfoot>
    </table>
    @JunkNote()

</main>
@Footer(versionName, versionRef)
</div>
</body>
</html>

}
