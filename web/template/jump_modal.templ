package template

templ JumpToIncidentModal() {
<div class="modal no-print" id="jumpToIncidentModal" tabindex="-1" aria-labelledby="jumpToIncidentModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <p class="modal-title fs-5" id="jumpToIncidentModalLabel">Go to Incident</p>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
      </div>
      <div class="modal-body">
        <input id="jump-to-incident-number" type="text" inputmode="numeric" autocomplete="off"
               class="form-control" placeholder="Incident number" aria-label="Incident number"
               aria-describedby="jump-to-incident-preview" />
        <div id="jump-to-incident-preview" class="form-text text-truncate" aria-live="polite"></div>
        <p class="mt-2 mb-0 small text-body-secondary">
          <code>⏎</code> to go there, <code><span class="modifier-key">Ctrl+</span>⏎</code> to open it in a new tab
        </p>
      </div>
    </div>
  </div>
</div>
}
