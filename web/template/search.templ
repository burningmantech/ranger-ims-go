package template

templ Search(deployment, versionName, versionRef string) {
<!DOCTYPE html>
<html lang="en">
@Head("Search Everywhere", "search.js", false, versionRef)

<body>
<div class="container-fluid">
@Header(deployment)
@Nav("")
<main id="main" tabindex="-1">
<h1 id="doc-title">Search Everywhere</h1>

@ErrorInfo()

@HelpModal("Search", "searching") {
  <p class="mb-0">Keyboard shortcuts</p>
  <ul>
    <li><kbd>/</kbd>: jump to search field</li>
  </ul>
  @helpShortcutsOffNote()
}

    <p class="no-print">
      This search works differently than searches elsewhere in IMS. This is still case-insensitive, but
      it only looks for substrings. For example, if you search "cat dog", you will match "Bobcat Dog",
      but not "cat. dog" or "cat and dog" or "cat &nbsp;dog" (two spaces between the words).
    </p>

    <p class="no-print">
      To search by regular expression instead, enclose a pattern in slashes, like "/ab?c/".
      Regular expression matching is also case-insensitive.
    </p>

    <div class="row">
      <div id="search_container" class="form-group form-group-sm col-sm-6">
        <div class="flex-input-container no-print">
          <label for="search_input" class="control-label visually-hidden">
            Search
          </label>
          <input
                  id="search_input"
                  type="search"
                  maxlength="256"
                  class="form-control search-box"
                  inputmode="latin"
                  { NoAutofill()... }
                  aria-controls="search_results_table"
          />
          <button id="search_button" type="button" class="btn btn-primary ms-2 text-nowrap">
            <span id="search_spinner" class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
            Search
          </button>
        </div>
      </div>
      <div class="col-sm-6 no-print">
        <button
                id="show_kind"
                type="button"
                class="btn btn-light btn-sm dropdown-toggle"
                data-bs-toggle="dropdown"
                data-bs-auto-close="outside"
        >
          All Types
        </button>
        <ul id="ul_show_kind" class="dropdown-menu">
          <li data-menu-filter-keep><button type="button" id="show_kind_toggle_all" class="dropdown-item">Select/Deselect All</button></li>
          <li><button type="button" class="dropdown-item dropdown-item-checkable dropdown-item-checked" aria-pressed="true" data-value="incident">Incidents</button></li>
          <li><button type="button" class="dropdown-item dropdown-item-checkable dropdown-item-checked" aria-pressed="true" data-value="field_report">Field Reports</button></li>
          <li><button type="button" class="dropdown-item dropdown-item-checkable dropdown-item-checked" aria-pressed="true" data-value="visit">Visits</button></li>
        </ul>
        { }
        <button
                id="show_event"
                type="button"
                class="btn btn-light btn-sm dropdown-toggle"
                data-bs-toggle="dropdown"
                data-bs-auto-close="outside"
        >
          All Events
        </button>
        <ul id="ul_show_event" class="dropdown-menu">
          <li data-menu-filter-keep><button type="button" id="show_event_toggle_all" class="dropdown-item">Select/Deselect All</button></li>
          <template id="show_event_template">
            <li><button type="button" class="dropdown-item dropdown-item-checkable dropdown-item-checked"
                   aria-pressed="true" data-value=""></button>
            </li>
          </template>
        </ul>
      </div>
    </div>

    <p id="search_results_info" class="text-body-secondary" aria-live="polite"></p>

    <table id="search_results_table" class="table table-striped table-hover">
      <caption class="visually-hidden">Search results</caption>
      <thead>
      <tr>
        <th scope="col">Event</th>
        <th scope="col">Type</th>
        <th scope="col">#</th>
        <th scope="col">Created</th>
        <th scope="col">Summary</th>
        <th scope="col">Excerpt</th>
      </tr>
      </thead>
      <tbody/>
    </table>
    <template id="search_result_row_template">
      <tr>
        <td class="result-event"></td>
        <td class="result-kind"></td>
        <td class="result-number"><a></a></td>
        <td class="result-created"></td>
        <td class="result-summary"></td>
        <td class="result-snippet text-body-secondary"></td>
      </tr>
    </template>
</main>
@Footer(versionName, versionRef)
</div>
</body>
</html>

}
